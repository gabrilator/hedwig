{
  "name": "hedwig",
  "version": "0.1.0",
  "description": "Email sequences from your own mailboxes: replies read back, an AI triage agent. Self-hosted, never relays mail.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --port 5180",
    "build": "vite build && npm run build:worker",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=build-worker/index.js --packages=external",
    "preview": "node build/index.js",
    "start": "node scripts/start.js",
    "start:web": "node build/index.js",
    "start:worker": "node build-worker/index.js",
    "worker": "node --env-file=.env --import tsx src/worker/index.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "seed:user": "node --env-file=.env --import tsx scripts/seed-user.ts"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "4.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-oauth/oauth2-server": "^5.3.0",
    "agenda": "6.2.6",
    "imapflow": "1.7.8",
    "luxon": "3.7.2",
    "mailparser": "3.9.20",
    "mongodb": "7.6.0",
    "nodemailer": "9.1.1",
    "papaparse": "5.7.0",
    "sanitize-html": "2.17.0",
    "xlsx": "0.18.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/luxon": "3.7.5",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.4.1",
    "@types/nodemailer": "8.0.1",
    "@types/papaparse": "5.5.2",
    "@types/sanitize-html": "2.16.1",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
