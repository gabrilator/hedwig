# ---- required ----
MONGODB_URI=mongodb://localhost:27017      # with docker compose this is overridden to mongodb://mongo:27017
MONGODB_DB=hedwig
ORIGIN=https://hedwig.example.com          # the one host the app lives on; forms only work here, other hosts redirect
TRACKING_BASE_URL=https://hedwig.example.com   # open pixels and unsubscribe links; a separate tracking domain if you like
HEDWIG_MASTER_KEY=            # 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BODY_SIZE_LIMIT=25M
HEDWIG_LANDING=                # optional: 1 shows the public home page at / to signed-out visitors; empty sends them to the login

# ---- first user (created at first boot if that email does not exist) ----
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_ORG_NAME=                # optional: an org created with the first user; rename or delete it on Team

# ---- reply agent: Jev labels replies, Gemini writes drafts (and labels when Jev is not set) ----
TYPESAFE_API_KEY=             # optional: console.typesafe.ai → API keys. With it, Jev labels replies; Gemini steps in when Jev can't answer.
GEMINI_API_KEY=               # aistudio.google.com → API keys. With neither key replies are matched and stopped but never labelled.
GEMINI_DAILY_CAP=300          # optional: model calls (Jev and Gemini) per UTC day for the whole instance

# ---- Connect with Microsoft (Microsoft 365 mailboxes; an Entra app registration, see README) ----
MS_TENANT_ID=common           # "common" = any Microsoft account; or your tenant id to restrict to your organisation
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# redirect URI to register: ${ORIGIN}/emails/microsoft/callback

# ---- Hedwig's own emails to its users: team invites, "someone is interested" notes (optional; else the first mailbox) ----
RESEND_API_KEY=
LOGIN_FROM=Hedwig <hedwig@example.com>
